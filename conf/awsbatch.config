// Queue and mounted databases are supplied by the institution, never created here.
process.executor = 'awsbatch'
process.queue = params.aws_queue
process {
    withName: HUMANN4_RUN { maxForks = 8 }
}
executor.queueSize = 16
aws.region = params.aws_region
aws.batch.maxSpotAttempts = 3
docker.enabled = true
// Batch supplies its own container configuration.
docker.runOptions = ''
