params {
    config_profile_name = 'Synthetic integration test'
    config_profile_description = 'HUMAnN package demo reads and synthetic profiles; run tests/prepare_demo.py first'
    input = "${projectDir}/tests/data/samplesheet.csv"
    nucleotide_db = "${projectDir}/tests/data/chocophlan_DEMO"
    protein_db = "${projectDir}/tests/data/protein"
    utility_db = "${projectDir}/tests/data/utility"
}
process.resourceLimits = [cpus: 2, memory: '6.GB', time: '1.h']
